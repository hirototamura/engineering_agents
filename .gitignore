# Experiment run artifacts are separated by project. Keep generated run data
# local; commit only the curated ECLSS evaluation catalogue.
experiments/eclss/results/*
!experiments/eclss/results/.gitkeep
!experiments/eclss/results/evaluation.html
experiments/balancing_cube/results/*
!experiments/balancing_cube/results/.gitkeep

# ECLSS design-loop analysis run directories are regenerable and large. The
# datasets, scripts, and reports in this folder are curated source material.
experiments/eclss/analysis/response_surface/
experiments/eclss/analysis/one_at_a_time/
experiments/eclss/analysis/one_at_a_time_relieved/

# Archived ECLSS chains: the .tar.gz under experiments/eclss/runs/ is tracked.
# Extracted round directories stay local. Analysed figures/CSVs live in
# experiments/eclss/outputs/ and are tracked for the hackathon record.
experiments/eclss/runs/*/
artifacts/ssos-regression/
output/
041922_output/

