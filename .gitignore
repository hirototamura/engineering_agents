# Design-loop analysis: the run directories are regenerable and large, the
# datasets and the report are the deliverable and are small.
src/experiments/analysis/*
!src/experiments/analysis/.gitkeep
!src/experiments/analysis/datasets/
!src/experiments/analysis/design_loop_analysis.html
!src/experiments/analysis/design_loop_analysis.ja.html
!src/experiments/analysis/design_loop_analysis.findings.json

# Archived chains: the .tar.gz under experiments/runs/ is what is tracked.
# Extracted round directories stay local. Analysed figures/CSVs live in
# experiments/outputs/ and are tracked for the hackathon record.
experiments/runs/*/
artifacts/ssos-regression/
output/
041922_output/

